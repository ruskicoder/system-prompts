{
  "schemaVersion": "1.0",
  "meta": {
    "description": "Single source of truth for reverse-skill task routing. master-route.ps1 / verify-routing-coherence.ps1 / test-routing.ps1 / extract-summaries.ps1 all read this file. Change routing rules only here, not in route tables scattered across markdown or ps1 files (generator scripts maintain the docs, or the docs at least stay consistent with this file).",
    "fallbackId": "R0",
    "scoring": "Each keyword rule that hits adds the route to the candidate set; the route with the highest hit score, taken in priority array order, becomes PRIMARY; on a tie the route earlier in priority wins; when no rule hits, fall back to fallbackId.",
    "maintainers": [
      "The priority table in skills/MASTER-ROUTING.md maps one to one to the priority field of this file",
      "skills/scripts/verify-routing-coherence.ps1 checks that the two are consistent"
    ]
  },
  "routes": {
    "R1": {
      "label": "APK reverse",
      "skill": "apk-reverse/SKILL.md",
      "keywords": [
        { "must": "(?<![A-Za-z0-9_])apk(?![A-Za-z0-9_])|smali|jadx|apktool|(?<![A-Za-z0-9_])android(?![A-Za-z0-9_])|android.?reverse|repackag|root.?detect|cert(?:ificate)?.?(?:check|validat|verif)|certificate.?pinning|ssl.?pinning|pinning.?bypass", "note": "Bare android, root detection, certificate validation and pinning bypass are common APK analysis requests" }
      ]
    },
    "R2": {
      "label": "Mobile reverse (Android+iOS)",
      "skill": "mobile-reverse/SKILL.md",
      "keywords": [
        { "must": "(?<![A-Za-z0-9_])ipa(?![A-Za-z0-9_])|ios.?reverse|objection|mobsf|mobile.?reverse" },
        { "must": "fairplay|supf|\\bsinf\\b|ipa.?(?:unpack|decrypt|dump)|decrypt\\w*.?(?:an? |the )?ipa", "note": "FairPlay/SUPF/SINF and offline IPA decryption go to the iOS side (fairplay-decrypt)" },
        { "must": "jailbreak", "mustAll": ["ios|iphone|ipad|mobile|objection|ipa"], "note": "jailbreak goes to mobile only with an iOS context" }
      ]
    },
    "R3": {
      "label": "JS / frontend reverse",
      "skill": "js-reverse/SKILL.md",
      "keywords": [
        { "must": "js.?reverse|webpack|cryptojs|frontend.?(?:sign|encrypt|crypto)|jshook|cdp|encrypted.?param|param\\w*.?encrypt|js.?(?:encrypt|decrypt|crypto)|packet.?capture|traffic.?capture|capture.?(?:the.?)?traffic|http.?capture|request.?replay|replay\\w*.?request|sign.?param|sign.?algorithm|signature|request.?sign|signing.?algorithm|hook\\w*.?param|api.?sign", "note": "Packet capture, HTTP capture and request replay belong to the JS frontend chain (anything-analyzer)" }
      ]
    },
    "R4": {
      "label": "DSL VM reverse",
      "skill": "reverse-engineering/dsl-vm-reverse/SKILL.md",
      "keywords": [
        { "must": "dsl.?vm|fireye|opcode.?vm|custom.?(?:vm|virtual.?machine)" }
